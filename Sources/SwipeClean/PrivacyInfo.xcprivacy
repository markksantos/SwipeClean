<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  SwipeClean collects nothing and tracks nobody. The app makes zero network
	  requests: every photo, quality score, statistic and generated video stays
	  on device. There are no third-party SDKs.

	  UserDefaults is the only "required reason" API the app touches. Photo dates
	  come from PHAsset.creationDate (PhotoKit metadata), which is not the
	  FileTimestamp category, and the storage dashboard sums PHAsset sizes rather
	  than reading device free space — so neither category is declared here.
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- Settings, lifetime stats, streaks and the onboarding flag. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
