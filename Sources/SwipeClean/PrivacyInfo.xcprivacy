<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  SwipeClean collects nothing and tracks nobody. There are no third-party
	  SDKs, no analytics, no accounts, and no server of ours for anything to be
	  sent to: every photo, quality score, statistic and generated video stays on
	  device.

	  The app is not fully offline, and must not claim to be. Image requests set
	  `isNetworkAccessAllowed = true`, so PhotoKit will pull a full-resolution
	  original down from the user's own iCloud Photo Library when only an
	  optimised copy is on device. That traffic is between the user and Apple, on
	  the user's behalf, and carries nothing of ours.

	  UserDefaults is the only "required reason" API the app touches. Photo dates
	  come from PHAsset.creationDate (PhotoKit metadata), which is not the
	  FileTimestamp category, and the storage dashboard sums PHAsset sizes rather
	  than reading device free space — so neither category is declared here.
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- Settings, lifetime stats, streaks and the onboarding flag. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
