// SwipeClean — secrets template.
//
// Copy this file to `Secrets.xcconfig` (which is gitignored) and fill in your
// keys. `Secrets.xcconfig` is referenced by project.yml and feeds values into
// the build settings / Info.plist.
//
//   cp Secrets.example.xcconfig Secrets.xcconfig
//
// Pixabay free-music library (optional). Get a key at:
//   https://pixabay.com/api/docs/
// If left blank, the Supercut "Free Library" tab degrades gracefully and users
// can still pick music from Apple Music or Files.
PIXABAY_API_KEY =
